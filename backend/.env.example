APP_ENV=development
APP_NAME=NPTEL AI Notes Generator
DATABASE_URL=sqlite:///./nptel_notes.db
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REQUEST_TIMEOUT=120
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CONCURRENCY=1
CAPTION_SERVICE_URL=http://caption-service:3001
CAPTION_SERVICE_TIMEOUT=60
BACKEND_CORS_ORIGINS=http://localhost:5173
EXPORT_DIRECTORY=./exports
TRANSCRIPT_CHUNK_SIZE=12000
TRANSCRIPT_CHUNK_OVERLAP=500
SCRAPER_REQUEST_DELAY=1
SCRAPER_TIMEOUT=30
